      "triggers": [[964, "calls", "open shout (tOBig) at the benches"], [982, "villains", "the MPs gasp together"]]},
    {"f": [1005, 1034], "words": "He has to apologize,", "faces": {"plimsoll": ["sheepish"], "speaker": ["tacheUp"], "mp1": ["aghast", "tacheUp"], "mp2": ["aghast", "tacheUp"], "mp3": ["aghast", "tacheUp"], "mp4": ["aghast", "tacheUp"]},
