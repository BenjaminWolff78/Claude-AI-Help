    {"f": [1034, 1108], "words": "but the newspapers love it, and Britain takes his side.", "faces": {"plimsoll": ["smug", "proud"], "newsboy": ["beam"], "speaker": ["tacheUp", "tache"], "mp1": ["tacheUp", "worry"], "mp2": ["tacheUp", "worry"], "mp3": ["tacheUp", "worry"], "mp4": ["tacheUp", "worry"]}},
    {"f": [1108, 1160], "words": "A year later, the law passes.", "faces": {"owner": ["tacheUp", "shock"], "inspector": ["tache"], "clerk": ["tache"], "plimsoll": ["smile", "proud"]}},
    {"f": [1160, 1240], "words": "Every ship needs a line. One catch. Owners paint it wherever they like.", "faces": {"owner": ["worry", "scheme"], "inspector": ["tache"], "clerk": ["tache"], "plimsoll": ["proud", "calm"]}},
    {"f": [1240, 1296], "words": "One paints it on the smokestack.", "faces": {"owner": ["scheme", "tacheUp"], "plimsoll": ["calm", "bored"], "inspector": ["tache"]}},
    {"f": [1296, 1396], "words": "Here's the trick. Load a ship heavier, and it sinks deeper, until every wave", "faces": {"plimsoll": ["determined", "stern"], "sailorC": ["worry"]}},
    {"f": [1396, 1430], "words": "walks onto the deck.", "faces": {"plimsoll": ["determined", "stern"], "sailorC": ["shock", "breakdown"]}},
    {"f": [1430, 1528], "words": "Picture a toy boat in a barrel. One more penny, and the water's over the line.", "faces": {"plimsoll": ["smug"], "owner": ["tache", "worry", "gulp"]}},
    {"f": [1528, 1625], "words": "In 1890, the government finally decides where the line goes.", "faces": {"inspector": ["tache"], "plimsoll": ["calm", "proud"], "owner": ["tache", "tacheUp"], "sailorA": ["worry"], "sailorB": ["worry"], "sailorC": ["worry"]}},
    {"f": [1625, 1713], "words": "So, the next time that owner pats his hull, the water's over the line,", "faces": {"owner": ["tacheUp", "worry"], "inspector": ["tache"], "plimsoll": ["calm", "smile_closed", "proud"], "sailorA": ["worry"], "sailorB": ["worry"], "sailorC": ["worry"]}},
    {"f": [1713, 1746], "words": "and his ship stays home.", "faces": {"owner": ["breakdown", "worry"], "inspector": ["tache"], "plimsoll": ["smile_closed", "calm"], "sailorA": ["worry"], "sailorB": ["worry"], "sailorC": ["worry"]}},
    {"f": [1746, 1856], "words": "Today, every cargo ship on Earth carries Paintbrush Plimsoll's circle.", "faces": {"plimsoll": ["proud", "smile_closed"], "owner": ["sheepish", "worry"], "inspector": ["tache"], "sailorA": ["joy", "grin", "worry"], "sailorB": ["joy", "grin", "worry"], "sailorC": ["joy", "grin", "worry"]}},
