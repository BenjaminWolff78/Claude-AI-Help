  "beats": [
    {"f": [0, 105], "words": "Shipowners loaded their own ships until they sank, and got rich doing it.", "faces": {"owner": ["scheme", "tacheUp"], "insurer": ["fakegrin"], "sailorA": ["worry"], "sailorB": ["worry"], "docker": ["strain"]}},
    {"f": [105, 245], "words": "You see, in Victorian Britain, an old ship insured for more than it was worth, was worth more sunk.", "faces": {"owner": ["scheme", "sly"], "insurer": ["fakegrin", "scheme"], "sailorA": ["worry"], "sailorB": ["worry"], "docker": ["strain"]}},
    {"f": [245, 337], "words": "So, owners piled on cargo until the deck was almost underwater.", "faces": {"owner": ["scheme"], "insurer": ["fakegrin"], "sailorA": ["worry"], "sailorB": ["worry"], "docker": ["strain"]}},
    {"f": [337, 389], "words": "The owner pats the hull. She'll float,", "faces": {"owner": ["tacheUp", "scheme"], "insurer": ["fakegrin"], "sailorA": ["worry"], "sailorB": ["worry"], "docker": ["strain"]}},
    {"f": [389, 452], "words": "she doesn't. Insurance pays out,", "faces": {"sailorA": ["yikes", "breakdown"], "sailorB": ["yikes", "breakdown"], "sailorC": ["yikes", "breakdown"]}},
    {"f": [452, 562], "words": "and he buys two more. Over 2,000 sailors went to court for refusing to climb aboard.", "faces": {"owner": ["scheme", "sly"], "insurer": ["fakegrin"], "constable": ["tache"], "sailorA": ["angry", "worry", "cold"], "sailorB": ["angry", "worry", "cold"], "sailorC": ["angry", "worry", "cold"]}},
    {"f": [562, 650], "words": "Then, a politician named Samuel Plimsoll shows up with a paint pot.", "faces": {"plimsoll": ["determined"], "owner": ["tache"], "dealer2": ["tache"], "dealer4": ["tache"]}},
    {"f": [650, 720], "words": "His plan to save every sailor? One line of paint.", "faces": {"plimsoll": ["calm", "determined", "bored"], "owner": ["tache"], "dealer2": ["tache"], "dealer4": ["tache"]}},
    {"f": [720, 784], "words": "The owners howl. Paintbrush Plimsoll!", "faces": {"plimsoll": ["bored"], "owner": ["mock", "guffaw", "laugh"], "dealer2": ["mock", "guffaw", "laugh"], "dealer4": ["mock", "guffaw", "laugh"]},
      "triggers": [[720, "owners", "all three: closed-arc eyes, grin, brows up"], [729, "howl", "all three: mouths wide open, heads back, bodies shake"], [749, "Paintbrush Plimsoll!", "the quote plays on the laughing face (held)"]]},
    {"f": [784, 834], "words": "In 1875, Parliament drops his law", "faces": {"speaker": ["tache", "tacheUp"], "mp1": ["tache"], "mp2": ["tache"], "mp3": ["tache"], "mp4": ["tache"], "plimsoll": ["determined"]}},
    {"f": [834, 870], "words": "completely.", "faces": {"speaker": ["tacheUp", "tache"], "mp1": ["mock", "guffaw"], "mp2": ["mock", "guffaw"], "mp3": ["mock", "guffaw"], "mp4": ["mock", "guffaw"], "plimsoll": ["determined"]}},
    {"f": [870, 920], "words": "So, Plimsoll marches up to the speaker,", "faces": {"plimsoll": ["determined"], "speaker": ["tache"], "mp1": ["tache"], "mp2": ["tache"], "mp3": ["tache"], "mp4": ["tache"]}},
    {"f": [920, 964], "words": "shakes his fist in his face,", "faces": {"plimsoll": ["determined", "angry", "fury"], "speaker": ["aghast"], "mp1": ["tache"], "mp2": ["tache"], "mp3": ["tache"], "mp4": ["tache"]},
